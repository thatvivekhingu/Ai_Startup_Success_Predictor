# ==========================================
# Gujarat Startup News Notifier Configuration
# ==========================================

# General
NEWS_LOOKBACK_HOURS=24
MAX_NEWS_ITEMS=6

# Telegram Bot (Fastest, zero-setup, instant on mobile)
ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_personal_or_channel_chat_id

# Email SMTP Notification (Optional)
ENABLE_EMAIL=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password
EMAIL_FROM="Gujarat Startup Watcher" <your_email@gmail.com>
EMAIL_TO=recipient1@gmail.com,recipient2@domain.com
